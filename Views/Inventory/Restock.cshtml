@model MIS期末.Models.StockRecord
@{ ViewData["Title"] = "庫存調整"; var product = ViewBag.Product as MIS期末.Models.Product; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-box-seam text-primary" style="font-size:2rem"></i>
                <div>
                    <div class="fw-bold fs-5">@product?.Name</div>
                    <div class="text-muted small">目前庫存：<span class="fw-bold text-@(product?.Stock <= product?.LowStockThreshold ? "danger" : "success")">@product?.Stock</span>　警戒值：@product?.LowStockThreshold</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-arrow-up-circle me-2 text-warning"></i>庫存調整</div>
            <div class="card-body">
                <form asp-action="Restock" method="post">
                    <input asp-for="ProductID" type="hidden" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">調整類型</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="Type" id="typeIn" value="In" checked />
                            <label class="btn btn-outline-success" for="typeIn"><i class="bi bi-plus-circle me-1"></i>進貨</label>

                            <input type="radio" class="btn-check" name="Type" id="typeOut" value="Out" />
                            <label class="btn btn-outline-danger" for="typeOut"><i class="bi bi-dash-circle me-1"></i>出貨</label>

                            <input type="radio" class="btn-check" name="Type" id="typeAdj" value="Adjustment" />
                            <label class="btn btn-outline-warning" for="typeAdj"><i class="bi bi-sliders me-1"></i>盤點</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold"></label>
                        <input asp-for="Quantity" class="form-control form-control-lg" type="number" min="1" placeholder="請輸入數量" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                        <div class="form-text">盤點模式：直接輸入最終庫存數量</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <input asp-for="Notes" class="form-control" placeholder="選填，例：廠商到貨、期末盤點..." />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill"><i class="bi bi-check-lg me-1"></i>確認調整</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
