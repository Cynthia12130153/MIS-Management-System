@model MIS期末.Models.Category
@{ ViewData["Title"] = "編輯分類"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><i class="bi bi-pencil me-2"></i>編輯分類</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input asp-for="CategoryID" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">分類名稱</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">說明</label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">儲存</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
