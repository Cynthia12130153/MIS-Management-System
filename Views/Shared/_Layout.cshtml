<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS & CRM 管理系統</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f0f2f5; }
        .sidebar { width: 240px; min-height: 100vh; background: #1e2a3a; position: fixed; top: 0; left: 0; z-index: 100; overflow-y: auto; }
        .sidebar .brand { padding: 20px 16px; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar .brand h5 { color: #fff; margin: 0; font-weight: 700; font-size: 1rem; }
        .sidebar .brand small { color: #90caf9; font-size: .75rem; }
        .sidebar .nav-section { padding: 12px 16px 4px; color: #90caf9; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
        .sidebar .nav-link { color: #b0bec5; padding: 8px 16px; border-radius: 8px; margin: 1px 8px; font-size: .875rem; display: flex; align-items: center; gap: 10px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(255,255,255,.1); color: #fff; }
        .sidebar .nav-link i { font-size: 1rem; width: 20px; }
        .main-content { margin-left: 240px; padding: 24px; min-height: 100vh; }
        .topbar { background: #fff; border-radius: 12px; padding: 12px 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .card { border: none; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .card-header { background: #fff; border-bottom: 1px solid #f0f0f0; border-radius: 12px 12px 0 0 !important; padding: 16px 20px; font-weight: 600; }
        .stat-card { border-radius: 12px; padding: 20px; color: #fff; }
        .stat-card .stat-value { font-size: 1.8rem; font-weight: 700; }
        .stat-card .stat-label { font-size: .8rem; opacity: .85; }
        .table th { background: #f8f9fa; font-weight: 600; font-size: .85rem; }
        .btn-sm { font-size: .8rem; }
    </style>
</head>
<body>
    <nav class="sidebar">
        <div class="brand">
            <h5><i class="bi bi-shop me-2"></i>POS & CRM</h5>
            <small>零售管理系統</small>
        </div>
        <ul class="nav flex-column mt-2">
            <li class="nav-section">主要功能</li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>儀表板</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index"><i class="bi bi-cart3"></i>銷售 / POS</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i>訂單管理</a></li>

            <li class="nav-section">商品管理</li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i>商品列表</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i>商品分類</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")" asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes"></i>庫存管理</a></li>

            <li class="nav-section">會員 CRM</li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i>會員管理</a></li>

            <li class="nav-section">報表分析</li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i>銷售報表</a></li>
        </ul>
    </nav>

    <div class="main-content">
        <div class="topbar">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("yyyy/MM/dd")</span>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-primary btn-sm"><i class="bi bi-cart-plus me-1"></i>開始銷售</a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
