@model IEnumerable<MIS期末.Models.Customer>
@{ ViewData["Title"] = "會員管理"; }

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="搜尋姓名或手機..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>搜尋</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">重設</a>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" class="btn btn-success btn-sm"><i class="bi bi-person-plus me-1"></i>新增會員</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="px-3">姓名</th>
                    <th>手機</th>
                    <th>等級</th>
                    <th>累積點數</th>
                    <th>累積消費</th>
                    <th>加入日期</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="px-3 fw-semibold">@c.Name</td>
                        <td>@c.Phone</td>
                        <td>
                            <span class="badge @(c.LevelID == 3 ? "bg-warning text-dark" : c.LevelID == 2 ? "bg-secondary" : "bg-light text-dark")">
                                @(c.LevelID == 3 ? "⭐ 金卡" : c.LevelID == 2 ? "🥈 銀卡" : "一般")
                            </span>
                        </td>
                        <td><span class="text-primary fw-bold">@c.Points</span> 點</td>
                        <td class="text-success fw-bold">NT$@c.TotalSpent.ToString("N0")</td>
                        <td class="text-muted small">@c.JoinDate.ToString("yyyy/MM/dd")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.CustomerID" class="btn btn-outline-primary btn-sm"><i class="bi bi-person me-1"></i>詳情</a>
                            <a asp-action="Edit" asp-route-id="@c.CustomerID" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">查無會員</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
