@model MIS期末.Models.Customer
@{ ViewData["Title"] = $"會員：{Model.Name}"; }

<div class="row g-3">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body text-center py-4">
                <i class="bi bi-person-circle text-primary" style="font-size:4rem"></i>
                <h5 class="mt-2 mb-0">@Model.Name</h5>
                <div class="mt-2">
                    <span class="badge fs-6 @(Model.LevelID == 3 ? "bg-warning text-dark" : Model.LevelID == 2 ? "bg-secondary" : "bg-light text-dark")">
                        @(Model.LevelID == 3 ? "⭐ 金卡會員" : Model.LevelID == 2 ? "🥈 銀卡會員" : "一般會員")
                    </span>
                </div>
                <div class="row g-2 mt-3">
                    <div class="col-6">
                        <div class="p-2 bg-light rounded">
                            <div class="fw-bold text-primary fs-4">@Model.Points</div>
                            <div class="small text-muted">累積點數</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-light rounded">
                            <div class="fw-bold text-success">NT$@Model.TotalSpent.ToString("N0")</div>
                            <div class="small text-muted">累積消費</div>
                        </div>
                    </div>
                </div>

                @if (ViewBag.NextLevel is MIS期末.Models.MembershipLevel nextLv)
                {
                    var needed = nextLv.MinPoints - Model.Points;
                    var pct = Model.Level != null ? Math.Min(100, (Model.Points - Model.Level.MinPoints) * 100 / Math.Max(1, nextLv.MinPoints - Model.Level.MinPoints)) : 0;
                    <div class="mt-3 text-start">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>距 @nextLv.Name 還差 @needed 點</span>
                            <span>@pct%</span>
                        </div>
                        <div class="progress" style="height:6px">
                            <div class="progress-bar bg-warning" style="width:@pct%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">基本資料</div>
            <div class="card-body">
                <table class="table table-borderless table-sm mb-0">
                    <tr><th class="text-muted">手機</th><td>@Model.Phone</td></tr>
                    @if (!string.IsNullOrEmpty(Model.Email)) { <tr><th class="text-muted">Email</th><td>@Model.Email</td></tr> }
                    @if (!string.IsNullOrEmpty(Model.Address)) { <tr><th class="text-muted">地址</th><td>@Model.Address</td></tr> }
                    <tr><th class="text-muted">加入日期</th><td>@Model.JoinDate.ToString("yyyy/MM/dd")</td></tr>
                </table>
                <a asp-action="Edit" asp-route-id="@Model.CustomerID" class="btn btn-outline-primary btn-sm w-100 mt-2">編輯資料</a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">點數調整</div>
            <div class="card-body">
                <form asp-action="AdjustPoints" method="post">
                    <input type="hidden" name="customerId" value="@Model.CustomerID" />
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">點數（正數=新增，負數=扣除）</label>
                        <input type="number" name="points" class="form-control form-control-sm" placeholder="例：100 或 -50" required />
                    </div>
                    <div class="mb-2">
                        <input type="text" name="description" class="form-control form-control-sm" placeholder="調整原因（必填）" required />
                    </div>
                    <button type="submit" class="btn btn-warning btn-sm w-100">調整點數</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-receipt me-2"></i>消費紀錄</div>
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr><th class="px-3">訂單</th><th>日期</th><th>項目</th><th>金額</th><th>點數</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Orders.OrderByDescending(o => o.OrderDate).Take(20))
                        {
                            <tr>
                                <td class="px-3"><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderID">#@o.OrderID</a></td>
                                <td class="small text-muted">@o.OrderDate.ToString("MM/dd HH:mm")</td>
                                <td class="small">@o.OrderDetails.Count 項</td>
                                <td class="fw-bold text-success">NT$@o.FinalAmount.ToString("N0")</td>
                                <td class="small text-primary">
                                    @if (o.PointsEarned > 0) { <span>+@o.PointsEarned</span> }
                                    @if (o.PointsRedeemed > 0) { <span class="text-danger ms-1">-@o.PointsRedeemed</span> }
                                </td>
                            </tr>
                        }
                        @if (!Model.Orders.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">無消費紀錄</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-gift me-2"></i>點數紀錄</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th class="px-3">時間</th><th>類型</th><th>點數</th><th>說明</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.PointRecords.OrderByDescending(r => r.CreatedAt).Take(15))
                        {
                            <tr>
                                <td class="px-3 small text-muted">@r.CreatedAt.ToString("MM/dd HH:mm")</td>
                                <td><span class="badge @(r.Type=="Earn"?"bg-success":"bg-danger")">@(r.Type=="Earn"?"獲得":"折抵")</span></td>
                                <td class="fw-bold @(r.Points>0?"text-success":"text-danger")">@(r.Points>0?"+":"")@r.Points</td>
                                <td class="small text-muted">@r.Description</td>
                            </tr>
                        }
                        @if (!Model.PointRecords.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">無點數紀錄</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
