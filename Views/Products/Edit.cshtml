@model MIS期末.Models.Product
@{ ViewData["Title"] = "編輯商品"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header"><i class="bi bi-pencil me-2 text-primary"></i>編輯商品</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input asp-for="ProductID" type="hidden" />
                    <input asp-for="CreatedAt" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryID" class="form-label fw-semibold">分類</label>
                        <select asp-for="CategoryID" asp-items="@ViewBag.Categories" class="form-select">
                            <option value="">-- 請選擇分類 --</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">NT$</span>
                                <input asp-for="Price" class="form-control" type="number" min="0" step="1" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cost" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">NT$</span>
                                <input asp-for="Cost" class="form-control" type="number" min="0" step="1" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LowStockThreshold" class="form-label fw-semibold"></label>
                            <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">上架中</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>儲存</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
