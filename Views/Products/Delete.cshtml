@model MIS期末.Models.Product
@{ ViewData["Title"] = "下架商品"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white"><i class="bi bi-exclamation-triangle me-2"></i>確認下架</div>
            <div class="card-body text-center py-4">
                <i class="bi bi-box-seam text-danger" style="font-size:3rem"></i>
                <h5 class="mt-3">@Model.Name</h5>
                <p class="text-muted">確定要將此商品下架嗎？商品資料將被保留，但不會顯示於銷售頁面。</p>
                <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
                    <input asp-for="ProductID" type="hidden" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-arrow-down-circle me-1"></i>確認下架</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>
